{
	"schemaVersion": 1,
	"levels": [
		{
			"name": "low",
			"review": "none",
			"release": "at-once",
			"onBreak": "follow-up"
		},
		{
			"name": "medium",
			"review": "agent",
			"release": "at-once",
			"onBreak": "follow-up"
		},
		{
			"name": "high",
			"review": "owner",
			"release": "at-once",
			"onBreak": "follow-up"
		},
		{
			"name": "critical",
			"review": "owner",
			"release": "after-proof",
			"onBreak": "block"
		}
	],
	"paths": [
		{
			"glob": ".claude/**",
			"level": "medium"
		},
		{
			"glob": ".github/**",
			"level": "high"
		},
		{
			"glob": ".hum/**",
			"level": "medium"
		},
		{
			"glob": "docs/**",
			"level": "low"
		},
		{
			"glob": "scripts/**",
			"level": "medium"
		},
		{
			"glob": "src/**",
			"level": "medium"
		},
		{
			"glob": "test/**",
			"level": "medium"
		},
		{
			"glob": "vendor/**",
			"level": "medium"
		},
		{
			"glob": "*.md",
			"level": "low"
		},
		{
			"glob": "*",
			"level": "medium"
		}
	],
	"roles": {
		"plan": {
			"file": "roles/plan.md",
			"purpose": "plan",
			"skills": [
				"hope:intent",
				"hope:shape"
			]
		},
		"build": {
			"file": "roles/build.md",
			"purpose": "build",
			"skills": []
		},
		"fix": {
			"file": "roles/fix.md",
			"purpose": "fix",
			"skills": []
		},
		"review": {
			"file": "roles/review.md",
			"purpose": "review",
			"skills": [
				"hope:judge"
			]
		}
	},
	"events": {
		"plan-ready": {
			"source": "plan"
		},
		"needs-split": {
			"source": "plan"
		},
		"plan-blocked": {
			"source": "plan"
		},
		"token-cap": {
			"source": "worker"
		},
		"approve": {
			"source": "review"
		},
		"request-changes": {
			"source": "review"
		},
		"needs-owner": {
			"source": "review"
		},
		"answered": {
			"source": "owner"
		},
		"owner-approved": {
			"source": "owner"
		},
		"owner-rejected": {
			"source": "owner"
		},
		"merged": {
			"source": "work-source"
		}
	},
	"kinds": [
		"feature",
		"fix",
		"docs",
		"hotfix",
		"check"
	],
	"checks": [
		"bun install --frozen-lockfile",
		"bun run check"
	],
	"runPlaces": [
		"ci"
	]
}
